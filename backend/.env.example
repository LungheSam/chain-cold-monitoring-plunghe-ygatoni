# Copy to backend/.env and fill in. Never commit backend/.env.
# On Railway, set the same names as service variables instead (see docs/deploy-railway.md).

PORT=3000
# Public URL of this back end; used as the "base" of the Thing Description
PUBLIC_BASE_URL=http://localhost:3000
# Dashboard origins allowed to call the API from a browser (comma-separated)
CORS_ORIGIN=http://localhost:5173
UNIT_IDS=cold-unit-01

# "firestore" (normal) or "memory" (no Firebase needed; data lost on restart; for trying things out)
STORE=firestore
# Only with STORE=memory: accept the test tokens "dev-supervisor" and "dev-viewer"
DEV_AUTH=0

# MQTT (local Mosquitto in dev: mqtts://localhost:8883; HiveMQ Cloud: mqtts://<cluster>.hivemq.cloud:8883)
MQTT_URL=mqtts://localhost:8883
# CA file for the self-signed dev broker. Leave empty for HiveMQ Cloud (public certificate).
MQTT_CA_FILE=../broker/mosquitto/certs/ca.crt
MQTT_USERNAME=backend
MQTT_PASSWORD=change-me

# Firebase Admin SDK credentials. Use ONE of these:
#  - locally: path to the service-account JSON (keep it in backend/secrets/, which is git-ignored)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json
#  - on Railway: paste the whole JSON into this variable instead (no files on Railway)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
FIREBASE_PROJECT_ID=your-project-id

# Africa's Talking. Username "sandbox" + the sandbox API key in development.
# Empty AT_API_KEY = SMS are only printed to the console.
AT_USERNAME=sandbox
AT_API_KEY=
# Empty = Africa's Talking default sender ID (docs/decisions.md D15)
AT_SENDER_ID=

# How long an HTTP action waits for the node's answer (ms)
COMMAND_TIMEOUT_MS=10000
