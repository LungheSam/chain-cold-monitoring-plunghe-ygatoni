# Copy to backend/.env and fill in. Never commit backend/.env.
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173
UNIT_IDS=cold-unit-01

# MQTT (local Mosquitto in dev, HiveMQ Cloud for the demo)
MQTT_URL=mqtts://localhost:8883
# CA file for the self-signed dev broker. Leave empty to use the system CAs (HiveMQ Cloud).
MQTT_CA_FILE=../broker/mosquitto/certs/ca.crt
MQTT_USERNAME=backend
MQTT_PASSWORD=change-me

# Must match edge CMD_HMAC_SECRET
CMD_HMAC_SECRET=change-me-to-a-long-random-string

# Firebase Admin SDK: path to the service-account JSON (keep it in backend/secrets/, which is git-ignored)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json
FIREBASE_PROJECT_ID=your-project-id
# Set this to use the local Firestore emulator instead of the real database
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Africa's Talking. Use username "sandbox" in development.
AT_USERNAME=sandbox
AT_API_KEY=change-me
# Optional registered sender ID (live account only)
AT_SENDER_ID=
