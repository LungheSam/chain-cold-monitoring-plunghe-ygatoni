{
  "name": "coldchain-backend",
  "version": "0.1.0",
  "private": true,
  "description": "MQTT ingest, Web Thing (WoT TD 1.1) API, Firestore storage and SMS alerts for the cold chain monitor",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "test": "node --test",
    "set-role": "node --env-file-if-exists=.env scripts/set-role.js"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "mqtt": "^5.16.1"
  }
}
