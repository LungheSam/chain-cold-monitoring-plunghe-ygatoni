# Copy to frontend/.env.local. Firebase web config values are not secret (they identify the
# project; security comes from firestore.rules), but we still keep them out of the code.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=
# Back end used for actions (acknowledgeAlarm, setThresholds, unlockDoor). Must be HTTPS in production.
VITE_BACKEND_URL=http://localhost:3000
# 1 = use the local Firebase emulators
VITE_USE_EMULATORS=0
