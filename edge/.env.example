# Copy to edge/.env and fill in. Never commit edge/.env.
UNIT_ID=cold-unit-01

# Timing profile: real (300 s / 120 s / 5 s) or demo (20 s / 15 s / 3 s)
PROFILE=demo

# 1 = fake sensors driven from the keyboard (laptop), 0 = real Pi hardware
MOCK_HARDWARE=1

# MQTT broker (local Mosquitto in dev, HiveMQ Cloud for the demo)
MQTT_HOST=localhost
MQTT_PORT=8883
MQTT_TLS=1
# CA file for the self-signed dev broker. Leave empty to use the system CAs (HiveMQ Cloud).
MQTT_CA_FILE=../broker/mosquitto/certs/ca.crt
MQTT_USERNAME=cold-unit-01
MQTT_PASSWORD=change-me

# Shared secret used to check that commands really come from the back end (HMAC-SHA256)
CMD_HMAC_SECRET=change-me-to-a-long-random-string

# Where the out-of-range total, excursions and offline queue are stored
DATA_DIR=./data
