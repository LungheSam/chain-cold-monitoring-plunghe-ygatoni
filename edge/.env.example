# Copy to edge/.env and fill in. Never commit edge/.env.
UNIT_ID=cold-unit-01

# Timing profile: real (300 s / 120 s / 5 s) or demo (20 s / 15 s / 3 s)
PROFILE=demo

# 1 = fake sensors driven from the keyboard (laptop), 0 = real Pi hardware
MOCK_HARDWARE=1

# I2C address of the LCD backpack (check with: i2cdetect -y 1). Usually 0x27, sometimes 0x3f.
LCD_ADDRESS=0x27

# MQTT broker (local broker in dev, EMQX Cloud Serverless for the demo)
MQTT_HOST=localhost
MQTT_PORT=8883
MQTT_TLS=1
# CA file for the self-signed dev broker. Leave empty to use the system CAs (EMQX Cloud).
MQTT_CA_FILE=../broker/mosquitto/certs/ca.crt
MQTT_USERNAME=cold-unit-01
MQTT_PASSWORD=change-me

# Extension: 4x4 keypad and solenoid lock (1 = fitted). In mock mode the keypad is the console
# command `key 1234#` and the lock is printed. PINs: python -m coldchain.pins add <name>
KEYPAD_INSTALLED=1
LOCK_INSTALLED=1
PINS_FILE=./pins.json
# Lock coil power time per unlock (s). Our cabinet lock needs a short pulse (label: 500 ms).
LOCK_PULSE_S=0.5
# 1 only for a relay module that switches on with a LOW input (prefer HIGH, or set its jumper to H).
LOCK_ACTIVE_LOW=0
# What opens the door: relay (relay module + cabinet lock) or servo (servo turns a latch, demo build).
LOCK_TYPE=relay
# Servo only: latch angles and the pulse widths for 0 and 180 degrees. Find the angles with
#   .venv/bin/python -m tests.hw.test_lock 45     (moves the servo to 45 degrees)
SERVO_LOCKED_DEG=0
SERVO_UNLOCKED_DEG=90
SERVO_MIN_PULSE_MS=0.5
SERVO_MAX_PULSE_MS=2.4

# Where the out-of-range total, excursions and offline queue are stored
DATA_DIR=./data
